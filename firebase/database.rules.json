{
  "rules": {
    ".read": false,
    ".write": false,

    "orbital_metrics": {
      ".read": true,
      "$key": {
        ".write": true,
        ".validate": "$key.matches(/^(sat|evt|loads)$/) && newData.isNumber() && newData.val() >= 1 && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
      }
    },

    "orbital_countries": {
      ".read": true,
      "$code": {
        ".write": true,
        ".validate": "$code.matches(/^[A-Z]{2}$/) && newData.isNumber() && newData.val() >= 1 && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
      }
    },

    "orbital_presence": {
      ".read": true,
      "$sid": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['country', 'since', 'lastSeen']) && newData.child('country').isString() && newData.child('country').val().matches(/^[A-Z?]{2}$/) && newData.child('since').isNumber() && newData.child('lastSeen').isNumber() && newData.child('lastSeen').val() <= now + 60000)",
        "lastSeen": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    }
  }
}

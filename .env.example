# Optional Firebase Realtime Database URL for anonymous visitor analytics
# (admin panel).
# - Omit the variable (or leave the sample URL) to use the built-in default.
# - Set to a valid https://*.firebaseio.com / *.firebasedatabase.app root to override.
# - Set to off (or disabled / false / 0) to disable remote analytics entirely.
# Security comes from firebase/database.rules.json — publish those rules
# before going live. Never use root ".read: true / .write: true".
VITE_FIREBASE_RTDB_URL=https://orbital-congestion-sim-default-rtdb.firebaseio.com
